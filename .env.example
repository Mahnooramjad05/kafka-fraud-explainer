# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_PARTITIONS=3

# Scoring / explanation
RISK_THRESHOLD=0.6
EXPLAIN_BATCH_SIZE=8
EXPLAIN_BATCH_WAIT_MS=200
EXPLAIN_MAX_ATTEMPTS=3
EXPLAIN_RETRY_BACKOFF_S=1.0

# LLM: mock (default, offline), openai or anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
